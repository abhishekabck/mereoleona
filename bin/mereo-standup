#!/usr/bin/env bash
# mereo-standup — format yesterday's (or today's) timer log as a standup message
# Usage:  mereo-standup           → yesterday
#         mereo-standup --today   → today
#         mereo-standup --date 2026-10-25

set -euo pipefail

LOG="$HOME/.config/mereoleona-timer/log.json"

c_gold='\033[1;38;2;242;168;30m'
c_grn='\033[0;32m'
c_dim='\033[2m'
c_rst='\033[0m'

# ── determine target date ─────────────────────────────────────────────────────
TARGET=""
for arg in "$@"; do
    case "$arg" in
        --today) TARGET="$(date +%F)" ;;
        --date)  ;;   # handled below
    esac
done
# handle "--date YYYY-MM-DD"
for i in "${!@}"; do
    if [[ "${!i}" == "--date" ]]; then
        next=$((i+1))
        TARGET="${!next:-}"
        break
    fi
done 2>/dev/null || true

if [[ -z "$TARGET" ]]; then
    # default: yesterday
    TARGET="$(date -d 'yesterday' +%F 2>/dev/null || date -v-1d +%F 2>/dev/null || echo "")"
    if [[ -z "$TARGET" ]]; then
        echo "Could not determine yesterday's date. Pass --today or --date YYYY-MM-DD." >&2
        exit 1
    fi
fi

# ── read log ──────────────────────────────────────────────────────────────────
if [[ ! -f "$LOG" ]]; then
    echo "No log found at $LOG. Start and complete a task first." >&2
    exit 1
fi

# extract entries for target date using python3 (always available on Ubuntu)
ENTRIES="$(python3 - "$LOG" "$TARGET" <<'PYEOF'
import json, sys
log_path, target = sys.argv[1], sys.argv[2]
with open(log_path) as f:
    data = json.load(f)
entries = [e for e in data if e.get('date') == target]
for e in entries:
    secs = int(e.get('duration', 0))
    h, rem = divmod(secs, 3600)
    m = rem // 60
    ticket = e.get('ticket', 'P')
    task   = e.get('task', '')
    status = e.get('status', '')
    print(f"{ticket}\t{task}\t{h}h {m:02d}m\t{status}")
PYEOF
)"

# ── format output ─────────────────────────────────────────────────────────────
DIVIDER="───────────────────────────────────────────"

MSG=""
MSG+="📋 Standup — ${TARGET}"$'\n'
MSG+="${DIVIDER}"$'\n'

TOTAL_SECS=0
COUNT=0

while IFS=$'\t' read -r ticket task duration status; do
    [[ -z "$ticket" ]] && continue
    icon="✓"
    [[ "$status" == "stopped" ]] && icon="✗"
    line="$(printf '%-14s %-45s %s' "${icon} ${ticket}" "${task}" "${duration}")"
    MSG+="${line}"$'\n'
    COUNT=$((COUNT + 1))
    # accumulate seconds for total
    raw_secs="$(python3 -c "
import json
with open('$LOG') as f:
    data = json.load(f)
total = sum(int(e.get('duration',0)) for e in data if e.get('date')=='$TARGET' and e.get('ticket')=='$ticket' and e.get('task')=='$task')
print(total)
" 2>/dev/null || echo 0)"
    TOTAL_SECS=$((TOTAL_SECS + raw_secs))
done <<< "$ENTRIES"

if [[ $COUNT -eq 0 ]]; then
    printf "${c_dim}No completed tasks found for %s.${c_rst}\n" "$TARGET"
    exit 0
fi

# total duration
TOTAL_H=$((TOTAL_SECS / 3600))
TOTAL_M=$(( (TOTAL_SECS % 3600) / 60 ))
MSG+="${DIVIDER}"$'\n'
MSG+="$(printf 'Total: %dh %02dm  (%d task%s)' "$TOTAL_H" "$TOTAL_M" "$COUNT" "$([ $COUNT -ne 1 ] && echo s)")"$'\n'

# ── print ──────────────────────────────────────────────────────────────────────
printf "${c_gold}%s${c_rst}\n" "$MSG"

# ── clipboard ─────────────────────────────────────────────────────────────────
if command -v xclip &>/dev/null; then
    printf '%s' "$MSG" | xclip -sel clipboard
    printf "${c_grn}✓  Copied to clipboard${c_rst}\n"
elif command -v xsel &>/dev/null; then
    printf '%s' "$MSG" | xsel --clipboard --input
    printf "${c_grn}✓  Copied to clipboard${c_rst}\n"
elif command -v wl-copy &>/dev/null; then
    printf '%s' "$MSG" | wl-copy
    printf "${c_grn}✓  Copied to clipboard${c_rst}\n"
fi

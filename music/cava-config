# Mereoleona fire audio visualizer — cava config
[general]
framerate = 60
autosens = 1
overshoot = 20
bar_width = 2
bar_spacing = 1
sleep_timer = 5

[input]
# PipeWire provides the pulse monitor; 'auto' grabs whatever is playing
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average
orientation = bottom

[color]
background = default
gradient = 1
gradient_count = 8
gradient_color_1 = '#3A0D05'
gradient_color_2 = '#6E1810'
gradient_color_3 = '#8C1F16'
gradient_color_4 = '#C8341E'
gradient_color_5 = '#E8650E'
gradient_color_6 = '#F2811E'
gradient_color_7 = '#F2A81E'
gradient_color_8 = '#FFD86B'

[smoothing]
noise_reduction = 0.77

#!/usr/bin/env bash
# mereo-standup — format yesterday's (or today's) timer log as a standup message
# Usage:  mereo-standup           → yesterday
#         mereo-standup --today   → today
#         mereo-standup --date 2026-10-25

set -euo pipefail

LOG="$HOME/.config/mereoleona-timer/log.json"

c_gold='\033[1;38;2;242;168;30m'
c_grn='\033[0;32m'
c_dim='\033[2m'
c_rst='\033[0m'

# ── determine target date ─────────────────────────────────────────────────────
TARGET=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --today) TARGET="$(date +%F)"; shift ;;
        --date)  TARGET="${2:-}"; shift 2 ;;
        *)       shift ;;
    esac
done

if [[ -z "$TARGET" ]]; then
    TARGET="$(date -d 'yesterday' +%F 2>/dev/null || date -v-1d +%F 2>/dev/null || echo "")"
    if [[ -z "$TARGET" ]]; then
        echo "Could not determine yesterday's date. Pass --today or --date YYYY-MM-DD." >&2
        exit 1
    fi
fi

# ── read + format in one python pass ──────────────────────────────────────────
if [[ ! -f "$LOG" ]]; then
    printf "${c_dim}No log found at %s. Start and complete a task first.${c_rst}\n" "$LOG"
    exit 0
fi

OUTPUT="$(python3 -I - "$LOG" "$TARGET" <<'PYEOF'
import json, sys

log_path, target = sys.argv[1], sys.argv[2]
with open(log_path) as f:
    data = json.load(f)

entries = [e for e in data if e.get("date") == target]
if not entries:
    sys.exit(1)

divider = "───────────────────────────────────────────"
lines = []
lines.append(f"📋 Standup — {target}")
lines.append(divider)

total_secs = 0
for e in entries:
    secs = int(e.get("duration", 0))
    total_secs += secs
    h, rem = divmod(secs, 3600)
    m = rem // 60
    ticket = e.get("ticket", "P")
    task = e.get("task", "")
    status = e.get("status", "")
    icon = "✓" if status == "completed" else "✗"
    lines.append(f"{icon} {ticket:<13} {task:<44} {h}h {m:02d}m")

lines.append(divider)
th, trem = divmod(total_secs, 3600)
tm = trem // 60
count = len(entries)
s = "s" if count != 1 else ""
lines.append(f"Total: {th}h {tm:02d}m  ({count} task{s})")
print("\n".join(lines))
PYEOF
)" || true

if [[ -z "$OUTPUT" ]]; then
    printf "${c_dim}No completed tasks found for %s.${c_rst}\n" "$TARGET"
    exit 0
fi

# ── print ─────────────────────────────────────────────────────────────────────
printf "${c_gold}%s${c_rst}\n" "$OUTPUT"

# ── clipboard ─────────────────────────────────────────────────────────────────
if command -v wl-copy &>/dev/null; then
    printf '%s' "$OUTPUT" | wl-copy
    printf "${c_grn}✓  Copied to clipboard${c_rst}\n"
elif command -v xclip &>/dev/null; then
    printf '%s' "$OUTPUT" | xclip -sel clipboard
    printf "${c_grn}✓  Copied to clipboard${c_rst}\n"
elif command -v xsel &>/dev/null; then
    printf '%s' "$OUTPUT" | xsel --clipboard --input
    printf "${c_grn}✓  Copied to clipboard${c_rst}\n"
fi
